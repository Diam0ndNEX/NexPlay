# The mkxp-z engine release that tools/fetch_mkxp_core.sh downloads, from
# github.com/mateo-m/mkxp-z-apple-mobile (the core Empo uses). The release notes give the sha256.
# EMPO_COMMIT pins the Empo files the build borrows (GameCore.h, the bridge and the framework scripts).
MKXP_CORE_VERSION=v15
